# ─────────────────────────────────────────────────────────────
# No configuration is required to run this app.
#   npm install && npm run dev
# Everything below is optional.
# ─────────────────────────────────────────────────────────────

# How often the dashboard refetches, in milliseconds.
NEXT_PUBLIC_POLL_INTERVAL_MS=15000

# ─────────────────────────────────────────────────────────────
# COINALYZE (optional) — https://coinalyze.net/account/api-key/
#
# Free key. Adds venues that block direct API access from some
# regions (Binance, Bybit, OKX), plus long/short ratio and deeper
# open-interest history than any single exchange provides.
#
# Rate limit is 40 calls/min and each symbol counts as one call,
# so the provider batches and caches aggressively.
#
# Without this key the app still works — DefiLlama covers the same
# venues for free with no signup, just with fewer fields.
# ─────────────────────────────────────────────────────────────
COINALYZE_API_KEY=

# ─────────────────────────────────────────────────────────────
# COINGECKO (optional) — https://www.coingecko.com/en/api
#
# Works with NO key. A free Demo key just raises the rate limit.
# Covers Binance / Bybit / OKX derivatives from any region.
# ─────────────────────────────────────────────────────────────
COINGECKO_API_KEY=

# ─────────────────────────────────────────────────────────────
# AI MARKET SUMMARY (optional) — https://console.anthropic.com
# Without a key, a rules-based summary is generated instead.
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# ALERT DELIVERY (optional)
# Browser + sound alerts work with no setup. These three need keys.
# ─────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ALERTS_EMAIL_FROM=

# ─────────────────────────────────────────────────────────────
# SUBGRAPHS (optional) — on-chain perp DEX data via The Graph
#
# Subgraphs index BLOCKCHAIN data. They work for on-chain DEXs
# (GMX, Synthetix) and cannot work for centralized exchanges —
# Binance/Bybit order books never touch a chain.
#
# Get a free key at https://thegraph.com/studio (100k queries/mo).
# Find current deployment IDs at https://thegraph.com/explorer
# Deployment IDs change when a protocol ships a new version, which
# is why these are env vars rather than hardcoded.
#
# NOTE ON SCOPE: GMX no longer needs this for the Pool Net Exposure
# panel — providers/gmxExposure.ts reads long/short open interest
# from GMX's keyless REST API on Arbitrum and Avalanche. The key
# still adds GMX as a full venue (funding rate, headline OI).
#
# Synthetix has no free REST equivalent, so it stays dark until
# this key is set. Its exposure path is written but UNVERIFIED —
# sanity-check the first numbers against Synthetix's own UI.
# ─────────────────────────────────────────────────────────────
THE_GRAPH_API_KEY=
GMX_SUBGRAPH_ID=
SYNTHETIX_SUBGRAPH_ID=

# Or bypass the gateway entirely with a self-hosted endpoint:
GMX_SUBGRAPH_URL=
SYNTHETIX_SUBGRAPH_URL=

# ─────────────────────────────────────────────────────────────
# ALCHEMY (optional) — https://dashboard.alchemy.com
#
# Supplies the SPOT price used to compute basis (perp vs spot).
# Their by-symbol endpoint is a volume-weighted average across
# CEXs and DEXs, which is a better reference than a single pool.
#
# Not an exchange source: Alchemy publishes no funding or OI.
#
# Without a key, the app uses Alchemy's public "docs-demo" key
# (heavily rate-limited) and falls back to DexScreener.
# ─────────────────────────────────────────────────────────────
ALCHEMY_API_KEY=

# ─────────────────────────────────────────────────────────────
# JUPITER PRICE API (optional) — https://dev.jup.ag/docs
#
# A third spot source for basis. Oracle-anchored with outlier
# filtering — strong for Solana assets.
#
# Not a perps source: this is the Price API, no funding or OI.
#
# Works without a key at lower rate limits.
# ─────────────────────────────────────────────────────────────
JUPITER_API_KEY=

# Only SOL's mint is hardcoded (verified in Jupiter's own docs).
# Wrapped BTC/ETH on Solana have several competing bridged mints
# with very different liquidity, so add them explicitly if wanted:
#   JUPITER_MINTS={"BTC":"<mint>","ETH":"<mint>"}
JUPITER_MINTS=

# ─────────────────────────────────────────────────────────────
# JUPITER PERPS — live, works with no key
#
# The adapter reads perps-api.jup.ag/v1/pool-info, which is
# public. JUPITER_API_KEY (above) only raises the rate limit.
#
# Jupiter has no funding rate — it's an LP-to-trader borrow
# model — so the funding column shows the long-minus-short
# borrow differential. Open interest comes from the provider
# layer: Jupiter's short side is one shared pool that can't be
# split per asset. See adapters/jupiter.ts for the full reasoning.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# COINBASE INTERNATIONAL — live, works with no key
#
# Market data on api.international.coinbase.com is fully public;
# only order placement needs CDP credentials. One request returns
# every perp with open interest and funding, so this venue is
# close to free to poll. Nothing to configure.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# DEFILLAMA — no longer free
#
# yields.llama.fi/perps now answers HTTP 402 for unauthenticated
# callers (https://defillama.com/subscription). The provider
# self-disables after two rejections so it stops costing latency
# on every poll. Coverage falls back to CoinGecko + Coinalyze.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# ETHERSCAN (optional) — https://etherscan.io/apidashboard
#
# Powers the Exchange Flow card's ETH side: balance lookups on a
# small set of verified Binance wallet addresses, used to derive
# net inflow/outflow. See providers/exchangeFlows/addresses.ts for
# how those addresses were verified.
#
# Free tier, but a key is required — Etherscan retired its old
# keyless V1 endpoint. Without this key, ETH exchange flow simply
# doesn't populate (BTC flow works with no key at all, via the
# public Esplora API).
# ─────────────────────────────────────────────────────────────
ETHERSCAN_API_KEY=

# ─────────────────────────────────────────────────────────────
# REDIS (recommended for any deployment) — Upstash
#
# Fixes two things that only break on serverless:
#
#   1. Each instance had its own in-memory cache, so the same URL
#      returned 25 venues or 16 depending on which one answered.
#   2. History was written to .data/, which Vercel wipes between
#      invocations — so the chart and OI percentile stayed blank.
#
# Easiest setup: Vercel dashboard -> Storage -> Create Database ->
# Upstash Redis. The credentials are injected automatically and
# you don't type them anywhere.
#
# Either naming convention works (Vercel has used both):
# ─────────────────────────────────────────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Without these the app falls back to the local filesystem, which
# is correct for `npm run dev` and wrong for anything deployed.

# ─────────────────────────────────────────────────────────────
# PERFORMANCE TUNING (optional)
#
# Every upstream is a third-party API and several geo-block by
# hanging rather than refusing. These caps stop one stalled venue
# from holding up the dashboard — it's dropped from that cycle
# and returns on the next poll.
#
# Lower = snappier, but more venues may miss the cut on a slow
# connection. Raise if you're on high-latency internet.
# ─────────────────────────────────────────────────────────────
FETCH_TIMEOUT_MS=9000
ADAPTER_TIMEOUT_MS=12000

# How many exchange adapters may be in flight at once, and how many
# assets whole-market mode processes concurrently.
#
# Firing all 23 adapters simultaneously made cold starts collapse —
# they raced each other through DNS and TLS and a third blew their
# deadline. Measured on the same commit, warm OS cache:
#
#   limit 8  -> 11.4s, 24 venues, 0 timeouts
#   limit 23 -> 15.3s, 18 venues, 1 timeout   (unbounded, the old way)
#
# Bounding is faster AND more complete. Raise only if you have
# reason to think your host handles bursts better.
ADAPTER_CONCURRENCY=8
ASSET_CONCURRENCY=3

# ─────────────────────────────────────────────────────────────
# DIAGNOSTICS
# Verbose provider logging: ON in development, OFF in production.
# Set "true" to force it on (useful on a deployed instance),
# "false" to quiet the terminal locally.
# ─────────────────────────────────────────────────────────────
DEBUG_PROVIDERS=

# ─────────────────────────────────────────────────────────────
# DRIFT ON-CHAIN (optional) — reads Solana directly
#
# data.api.drift.trade returns 403 in geofenced regions, but
# Solana chain state is not geofenced. This reads Drift's perp
# market accounts directly, which cannot be blocked or paywalled.
#
# Free key at https://helius.dev  (or use any Solana RPC URL)
#
# Verify it works BEFORE relying on it:
#     npm run check-drift
# ─────────────────────────────────────────────────────────────
HELIUS_API_KEY=

# Alternative: any Solana RPC endpoint (takes precedence)
SOLANA_RPC_URL=

# ─────────────────────────────────────────────────────────────
# OPTIONS INTELLIGENCE ENGINE (in progress, Phase 0)
#
# A completely separate module from everything above — no shared
# code, types, or state with the crypto dashboard. See
# src/lib/options/types.ts and the phased implementation plan.
# ─────────────────────────────────────────────────────────────

# TRADIER (required for the options-data side) — https://tradier.com
#
# Options chains with published greeks, quotes, and a sandbox
# environment. Get a sandbox token first and verify it before
# ever pointing this at production:
#     node scripts/check-tradier.mjs
TRADIER_API_KEY=
# "sandbox" (paper data) or "production". Defaults to sandbox.
TRADIER_ENV=sandbox

# ROBINHOOD (required for the account/watchlist side)
#
# Robinhood has no official API for stocks/options — this uses an
# UNOFFICIAL, reverse-engineered client (robinhood-nodejs), which
# violates Robinhood's Terms of Service. Accepted knowingly; see the
# phased plan's Phase 0 notes. Read-only usage only — this app never
# places trades.
#
# TOTP_SECRET is the same secret you'd scan into an authenticator
# app during Robinhood's 2FA setup — required so login can complete
# an MFA challenge unattended. Device-verification challenges (an
# email/SMS click-through) CANNOT be automated; if Robinhood forces
# one repeatedly, this integration will be unreliable and the
# manual-entry AccountProvider is the fallback.
#
# Verify before relying on it:
#     node scripts/check-robinhood.mjs
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_TOTP_SECRET=

DUNE_API_KEY=
